# Copy to config.yaml. config.yaml is gitignored.
gmail_accounts:
  - email: sbharri2@gmail.com
    user_id: steven
    chat_id: 0  # set by first_run_setup.py
    # Preferred: IMAP with an App Password. Set imap_password_env to the
    # env var name (NOT the password itself) that holds the App Password,
    # e.g. STEVEN_GMAIL_IMAP_PASSWORD. The actual password goes in .env.
    # Generate at https://myaccount.google.com/apppasswords (requires 2FA).
    imap_password_env: STEVEN_GMAIL_IMAP_PASSWORD
    # Legacy OAuth fallback. Used only when imap_password_env isn't set
    # or its env var is empty. Refresh tokens expire every 7 days for
    # OpenClaw's unverified app, so IMAP is the right default.
    token_path: ~/.google_workspace_mcp/credentials/sbharri2@gmail.com.json

email_sources:
  - name: amazon
    # Restrict to real order confirmations (subject "Ordered: ..."). The
    # same sender also pushes shipment/refund updates that the parser
    # can't and shouldn't try to enqueue.
    query: 'from:auto-confirm@amazon.com subject:Ordered newer_than:2d'
    parser: amazon
  - name: amazon_shipment
    query: "from:shipment-tracking@amazon.com newer_than:2d"
    parser: amazon_shipment
  # Venmo: subject filter excludes monthly statements + non-transactional emails.
  # See receipt-inspection.md — 10/37 venmo@venmo.com emails are non-transactional.
  - name: venmo
    query: 'from:venmo@venmo.com newer_than:2d (subject:"paid you" OR subject:"You paid" OR subject:"charged you" OR subject:"You charged")'
    parser: venmo
  # Generic Shopify/retailer order confirmations (Rhoback, Urban Outfitters,
  # Etsy, Zappos, piper+ivy, etc.). Use after configuring Allison's gmail to
  # forward category:purchases (excluding Amazon) to this account.
  - name: retailer_order
    query: 'subject:("Order #" OR "Order Confirmation" OR "Receipt #") newer_than:3d -from:amazon -from:venmo'
    parser: retailer_order
  # Citi Double Cash per-charge alerts
  - name: citi_alert
    query: 'from:info6.citi.com subject:"transaction was made" newer_than:3d'
    parser: citi_alert
  # Chase Amazon (Prime Visa) per-charge alerts
  - name: chase_alert
    query: 'from:alerts.chase.com subject:"You made" newer_than:3d'
    parser: chase_alert
  # Chase CC daily balance alert ("Your Prime Visa balance is $X")
  - name: chase_balance_summary
    query: 'from:alerts.chase.com subject:"balance is" newer_than:3d'
    parser: chase_balance_summary
  # PayPal payment receipts (Uber/Valve/Southwest/refunds/etc.)
  - name: paypal_payment
    query: 'from:paypal.com (subject:"payment to" OR subject:"refund from" OR subject:"USD") -subject:(statement OR "legal agreements" OR rewards OR offer OR crypto) newer_than:3d'
    parser: paypal_payment
  # Citi CC daily balance alert
  - name: citi_balance_summary
    query: 'from:info6.citi.com subject:"daily account balance alert" newer_than:3d'
    parser: citi_balance_summary
  # Coastal FCU per-transaction alerts (checking/savings deposits + withdrawals)
  - name: coastal_transaction_alert
    query: 'from:coastal24.com subject:"Transaction Alert" newer_than:3d'
    parser: coastal_transaction_alert
  # Coastal FCU daily balance summary — drives Phase 5 reconciliation
  - name: coastal_balance_summary
    query: 'from:coastal24.com subject:"Balance Summary" newer_than:3d'
    parser: coastal_balance_summary

ynab:
  budget_id: ""  # set by first_run_setup.py
  poll_interval_minutes: 30

ollama:
  endpoint: http://localhost:11434
  model: qwen3-coder:30b
  temperature: 0.3

telegram:
  quiet_hours: "22:00-07:00"
  daily_digest_time: "09:00"

paths:
  database: ./ynab_helper.db
  log_dir: ./logs
